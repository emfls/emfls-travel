---
import type { Guide } from '../data/content';
const { guide } = Astro.props as { guide: Guide };
---
<a class={`guide-card ${guide.tone}`} href={guide.route}><span class="card-art" aria-hidden="true"></span><span class="card-copy"><small>{guide.eyebrow}</small><h3>{guide.title}</h3><p>{guide.description}</p><span class="read-more">살펴보기 ↗</span></span></a>
