---
import BaseLayout from '../layouts/BaseLayout.astro'; import GuideCard from '../components/GuideCard.astro'; import DestinationCard from '../components/DestinationCard.astro'; import { guides } from '../data/content'; import { destinations } from '../data/destinations';
---
<BaseLayout title="EMFLS Travel — 여행의 다음 장면을 찾는 편집실" description="어디로 갈지부터 어떻게 준비할지까지 연결하는 여행 탐색 매거진."><section class="hero"><div><p class="eyebrow">A magazine for going somewhere</p><h1>어디로 갈지<br /><em>찾는</em> 여행.</h1><p>목적지의 이름만 찾는 것이 아니라, 누구와 어떤 속도로 무엇을 하고 싶은지부터 생각하는 여행 탐색 사이트입니다.</p></div><div class="hero-art" role="img" aria-label="여행의 풍경을 추상적으로 표현한 그래픽"></div></section><section class="section finder" id="trip-finder"><div class="finder-intro"><div><p class="eyebrow">Trip Finder · your conditions</p><h2>어떤 여행을<br />찾고 있나요?</h2></div><p>조건을 고르면 충주와 단양 중 지금의 여행에 가까운 순서로 안내합니다.</p></div><form id="trip-finder-form" class="finder-form"><fieldset><legend>누구와 가나요?</legend><label><input type="radio" name="companions" value="solo" /> 혼자</label><label><input type="radio" name="companions" value="couple" /> 커플</label><label><input type="radio" name="companions" value="family" /> 가족</label><label><input type="radio" name="companions" value="kids" /> 아이와</label></fieldset><fieldset><legend>여행 시간</legend><label><input type="radio" name="duration" value="day" /> 당일</label><label><input type="radio" name="duration" value="overnight" /> 1박 2일</label><label><input type="radio" name="duration" value="longer" /> 2박 이상</label></fieldset><fieldset><legend>여행 스타일</legend><label><input type="radio" name="environment" value="indoor" /> 실내 중심</label><label><input type="radio" name="environment" value="outdoor" /> 야외 중심</label><label><input type="radio" name="environment" value="both" /> 둘 다</label></fieldset><fieldset><legend>이동 방식</legend><label><input type="radio" name="transport" value="car" /> 자동차</label><label><input type="radio" name="transport" value="transit" /> 대중교통</label><label><input type="radio" name="transport" value="any" /> 상관없음</label></fieldset><fieldset><legend>여행 목적</legend><label><input type="radio" name="purpose" value="nature" /> 자연</label><label><input type="radio" name="purpose" value="rest" /> 휴식</label><label><input type="radio" name="purpose" value="kids-experience" /> 아이와 체험</label><label><input type="radio" name="purpose" value="drive" /> 드라이브</label><label><input type="radio" name="purpose" value="sightseeing" /> 가벼운 관광</label></fieldset><div class="finder-actions"><button class="finder-submit" type="submit">여행지 찾기 ↗</button><button class="finder-reset" type="reset">전체 초기화</button></div></form><div id="finder-results" class="finder-results" aria-live="polite" aria-atomic="true" hidden></div></section><section class="section"><div class="section-head"><h2>여행의 이유로<br />찾아보기</h2><p>같은 장소도 누구와, 언제, 무엇을 하러 가는지에 따라 전혀 다른 여행이 됩니다.</p></div><div class="link-grid"><a href="/family/">모두가 편안한 가족여행</a><a href="/with-kids/">아이의 질문을 따라가기</a><a href="/road-trip/">길 위의 여백 만들기</a><a href="/seasonal/">계절의 색을 만나기</a><a href="/stays/">오래 머무는 숙소 고르기</a><a href="/tips/">계획을 덜 복잡하게</a></div></section><section class="section"><div class="section-head"><h2>대표 목적지<br />먼저 보기</h2><p>장소를 나열하기보다, 어떤 여행자에게 잘 맞는지부터 읽어보세요.</p></div><div class="destination-grid">{destinations.map((destination)=><DestinationCard destination={destination} />)}</div></section><section class="section"><div class="section-head"><h2>이번 여행의<br />첫 장면</h2><p>아직 정해지지 않은 여행을 위한 편집자의 작은 힌트.</p></div><div class="guide-grid">{guides.map((guide)=><GuideCard guide={guide} />)}</div></section><script>import { destinations } from '../data/destinations'; import { getTripRecommendations } from '../lib/tripFinder'; const form = document.querySelector('#trip-finder-form') as HTMLFormElement; const results = document.querySelector('#finder-results') as HTMLDivElement; const render = () => { const formData = new FormData(form); const filters = { companions: String(formData.get('companions') ?? ''), duration: String(formData.get('duration') ?? ''), environment: String(formData.get('environment') ?? ''), transport: String(formData.get('transport') ?? ''), purpose: String(formData.get('purpose') ?? '') }; const recommendations = getTripRecommendations(destinations, filters); const selected = Object.values(filters).filter(Boolean).length; if (!selected) { results.hidden = true; results.innerHTML = ''; return; } results.hidden = false; results.innerHTML = `<div class="results-heading"><p class="eyebrow">${selected === 5 ? 'Your trip, taking shape' : 'Closest matches first'}</p><h3>${selected === 5 ? '지금의 조건에 맞는 여행지' : '선택한 조건에 가까운 여행지'}</h3><button type="button" class="results-reset">조건 다시 고르기</button></div><div class="result-list">${recommendations.map((item) => `<article class="result-card"><div class="result-card-art ${item.destination.visual}" aria-hidden="true"></div><div><p class="eyebrow">${item.destination.region}</p><h4>${item.destination.name}</h4><p>${item.reason}</p><div class="tag-row">${item.matched.length ? item.matched.map((key) => `<span>${key === 'companions' ? '동행' : key === 'duration' ? '여행 시간' : key === 'environment' ? '여행 스타일' : key === 'transport' ? '이동 방식' : '여행 목적'}</span>`).join('') : '<span>가까운 여행 방식</span>'}</div><a href="/destinations/${item.destination.slug}/">상세 가이드 보기 ↗</a></div></article>`).join('')}</div>`; results.querySelector('.results-reset')?.addEventListener('click', () => { form.reset(); render(); form.scrollIntoView({ behavior: 'smooth', block: 'start' }); }); }; form.addEventListener('submit', (event) => { event.preventDefault(); render(); results.scrollIntoView({ behavior: 'smooth', block: 'start' }); }); form.addEventListener('reset', () => requestAnimationFrame(render));</script></BaseLayout>
