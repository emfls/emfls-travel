---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { destinations } from '../../data/destinations'; import { travelGuides } from '../../data/guides';
export function getStaticPaths(){ return destinations.map((destination) => ({ params: { slug: destination.slug }, props: { destination } })); }
const { destination } = Astro.props; const destinationGuides = travelGuides.filter((guide) => guide.destination === destination.slug);
---
<BaseLayout title={`${destination.name} 여행 가이드 — EMFLS Travel`} description={destination.heroDescription} canonical={`/destinations/${destination.slug}/`}><section class={`destination-hero ${destination.visual}`}><div><p class="eyebrow">{destination.region}</p><h1>{destination.name}</h1><p class="destination-lead">{destination.heroDescription}</p><div class="tag-row hero-tags">{destination.bestFor.map((tag) => <span>{tag}</span>)}</div></div><div class="destination-hero-art" role="img" aria-label={`${destination.name}의 풍경을 표현한 추상 그래픽`}></div></section><section class="section destination-summary"><div class="section-head"><h2>이 여행의<br />기본 감각</h2><p>{destination.shortDescription}</p></div><div class="summary-grid"><div><small>추천 체류 시간</small><strong>{destination.recommendedStay}</strong></div><div><small>실내 / 야외</small><strong>{destination.indoorOutdoor.indoor} {destination.indoorOutdoor.outdoor}</strong></div><div><small>아이 동반</small><strong>{destination.withKids.fit}</strong></div><div><small>추천 계절</small><strong>{destination.bestSeasons.join(' · ')}</strong></div><div><small>이동</small><strong>{destination.transport}</strong></div><div><small>걷기와 주차</small><strong>{destination.parking}</strong></div></div></section><section class="section"><div class="section-head"><h2>잘 맞는<br />여행 방식</h2><p>장소 목록 대신, 이 지역에서 시간을 사용하는 방법을 먼저 살펴봅니다.</p></div><div class="destination-highlights">{destination.highlights.map((item, index)=><article><span>0{index+1}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></section><section class="section itinerary"><div class="section-head"><h2>추천 일정</h2><p>예약과 실시간 정보 없이도 조정할 수 있는 하루의 뼈대입니다.</p></div><div class="itinerary-list">{destination.itineraries.map((item)=><article><span>{item.time}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div></section><section class="section split-sections"><article><p class="eyebrow">With kids</p><h2>아이와 여행</h2><p>{destination.withKids.fit}</p><ul>{destination.withKids.notes.map((note)=><li>{note}</li>)}</ul></article><article><p class="eyebrow">Rainy day</p><h2>비 오는 날</h2><p>{destination.rainyDay}</p><a href="/with-kids/">아이와 여행 기준 보기 ↗</a></article></section><section class="section"><div class="section-head"><h2>출발 전<br />확인할 것</h2><p>현장에서 달라질 수 있는 정보는 공식 안내를 기준으로 다시 확인하세요.</p></div><ul class="check-list">{destination.tips.map((tip)=><li>{tip}</li>)}</ul></section><section class="section related"><div class="section-head"><h2>이 목적지의 실전 가이드</h2><p>여행 목적과 조건에 따라 더 구체적으로 계획해보세요.</p></div><div class="nearby-grid">{destinationGuides.map((guide)=><a class="nearby-card" href={`/destinations/${guide.destination}/${guide.slug}/`}><span class="eyebrow">{guide.intent}</span><h3>{guide.title}</h3><p>{guide.description}</p><span>가이드 열기 ↗</span></a>)}</div></section><section class="section related"><div class="section-head"><h2>이 여행과 함께 살펴보기</h2><p>지리와 여행 동선이 자연스럽게 이어지는 주변 목적지입니다.</p></div><div class="nearby-grid">{destination.relatedDestinations.map((nearby)=><a class="nearby-card" href={nearby.href}><span class="eyebrow">주변 목적지</span><h3>{nearby.name}</h3><p>{nearby.reason}</p><span>여행 허브 열기 ↗</span></a>)}</div></section><section class="section related"><div class="section-head"><h2>관련 가이드</h2><p>이 지역을 더 잘 읽는 데 도움이 되는 사이트 안의 다른 관점.</p></div><div class="link-grid">{destination.relatedGuides.map((guide)=><a href={guide.href}>{guide.label}</a>)}</div></section></BaseLayout>
