---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import '../../../styles/guides.css'; import { destinations } from '../../../data/destinations'; import { travelGuides } from '../../../data/guides';
export function getStaticPaths(){ return travelGuides.map((guide) => ({ params: { destination: guide.destination, guide: guide.slug }, props: { guide } })); }
const { guide } = Astro.props;
const destination = destinations.find((item) => item.slug === guide.destination);
const hubHref = `/destinations/${guide.destination}/`;
---
<BaseLayout title={`${guide.title} — EMFLS Travel`} description={guide.description} canonical={`/destinations/${guide.destination}/${guide.slug}/`}><section class={`guide-hero ${guide.visual}`}><div><p class="eyebrow">{guide.intent} · {destination?.name}</p><h1>{guide.title}</h1><p class="guide-lead">{guide.description}</p><div class="tag-row hero-tags">{guide.recommendedFor.map((tag) => <span>{tag}</span>)}</div></div><div class="guide-hero-art" aria-hidden="true"></div></section><section class="section guide-summary"><div class="section-head"><h2>먼저<br />판단하기</h2><p>{guide.summary}</p></div><div class="summary-grid"><div><small>추천 대상</small><strong>{guide.audience}</strong></div><div><small>체류 방식</small><strong>{guide.tripLength}</strong></div><div><small>이동</small><strong>{guide.transport}</strong></div><div><small>실내 / 야외</small><strong>{guide.indoorOutdoor}</strong></div><div><small>난이도</small><strong>{guide.difficulty}</strong></div><div><small>목적지 허브</small><strong><a href={hubHref}>{destination?.name} 전체 가이드 ↗</a></strong></div></div></section><section class="section guide-planning"><div class="section-head"><h2>여행<br />계획하기</h2><p>{guide.planning}</p></div></section><section class="section itinerary"><div class="section-head"><h2>추천 일정</h2><p>고정된 예약표가 아니라, 상황에 맞춰 조정할 수 있는 하루의 뼈대입니다.</p></div><div class="itinerary-list">{guide.itinerary.map((step)=><article><span>{step.label}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></article>)}</div></section><section class="section guide-tips"><div class="section-head"><h2>상황별<br />팁</h2><p>이 여행의 목적과 조건을 지키면서 계획을 바꾸는 방법입니다.</p></div><ul class="check-list">{guide.situationTips.map((tip)=><li>{tip}</li>)}</ul></section><section class="section"><div class="section-head"><h2>출발 전<br />체크리스트</h2><p>실제로 계획표에 옮겨 적을 수 있는 최소 준비입니다.</p></div><ul class="check-list">{guide.checklist.map((item)=><li>{item}</li>)}</ul></section><section class="section related"><div class="section-head"><h2>관련 가이드</h2><p>같은 목적지의 다른 조건과 주변 여행으로 이어집니다.</p></div><div class="link-grid">{guide.relatedGuides.map((related)=><a href={related.href}>{related.label}</a>)}</div></section><section class="section related"><div class="section-head"><h2>관련 목적지</h2><p>여행의 리듬을 바꿔 이어갈 수 있는 주변 목적지입니다.</p></div><div class="nearby-grid">{guide.relatedDestinations.map((nearby)=><a class="nearby-card" href={nearby.href}><span class="eyebrow">주변 목적지</span><h3>{nearby.name}</h3><p>{nearby.reason}</p><span>여행 허브 열기 ↗</span></a>)}</div></section></BaseLayout>
