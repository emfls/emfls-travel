---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageIntro from '../components/PageIntro.astro'; import { categoryPages } from '../data/content';
export function getStaticPaths(){ return Object.entries(categoryPages).map(([slug, page])=>({params:{section:slug}, props:{slug, page}})); }
const { slug, page } = Astro.props as {slug:keyof typeof categoryPages, page: (typeof categoryPages)[keyof typeof categoryPages]};
---
<BaseLayout title={`${page.title} — EMFLS Travel`} description={page.description} canonical={`/${slug}/`}><PageIntro kicker={page.kicker} title={page.title} description={page.description} accent={page.accent} /><section class="section"><div class="section-head"><h2>이 카테고리에서<br />먼저 볼 것</h2><p>정보를 많이 모으기보다 지금의 여행 조건에 맞는 질문부터 골라보세요.</p></div><div class="editorial-list">{page.links.map((link, index)=><article class="editorial-row"><span>0{index + 1}</span><h2>{link}</h2><a href="/tips/">기준 읽기 ↗</a></article>)}</div></section><section class="section"><div class="finder"><p class="eyebrow">지역 × 목적 × 조건</p><h2>다음에는 더 정확한 여행 가이드로 연결됩니다.</h2><p class="lead">EMFLS Travel은 장소를 나열하는 대신 여행자의 상황을 읽고, 필요한 정보의 순서를 설계해나갑니다.</p></div></section></BaseLayout>
